# Server-only. Local dev defaults to in-memory fixtures; never deploy demo mode.
AGENT_ID_DEMO=false
DATABASE_URL=postgresql://agent_id_app.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Optional additional trusted root CA from your database provider; TLS verification stays enabled.
DATABASE_SSL_CA=
# 32 random bytes, base64url. Encrypts site secrets at rest; losing it loses every site secret.
AGENT_ID_ENCRYPTION_KEY=
# The Supabase project whose sign-ins own products, such as https://YOUR-REF.supabase.co.
SUPABASE_URL=
PRUNE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Vercel sends CRON_SECRET as Bearer; set it to the same value as PRUNE_SECRET.
CRON_SECRET=REPLACE_WITH_THE_SAME_PRUNE_SECRET
