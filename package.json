{
  "name": "@parallel-research/agent-identification",
  "version": "0.1.0",
  "description": "Website-owned, session-scoped visitor self-classification widget and server verification helpers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/browser/index.js",
  "types": "./dist/types/browser/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./styles.css": "./dist/agent-id.css",
    "./script": "./dist/agent-id.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:package",
    "dev:collector": "node --import tsx scripts/dev-server.ts",
    "dev:examples": "node --import tsx scripts/example-server.ts",
    "site:create": "node scripts/site-config.mjs",
    "events": "node scripts/events.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
